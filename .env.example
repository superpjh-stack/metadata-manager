# 예시입니다. 자동으로 읽지 않으므로 실행 환경에 export 하세요.
# DEBUG=0
# SECRET_KEY=<운영 환경에서 생성한 무작위 비밀값>
# ALLOWED_HOSTS=your-internal-host.example
# DB_PATH=/absolute/path/db.sqlite3
# MEDIA_ROOT=/absolute/path/media
# Docker production example (write actual values to untracked .env):
# ALLOWED_HOSTS=metadata.187.52.127.215.sslip.io,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://metadata.187.52.127.215.sslip.io
# TRUST_PROXY=1
# SECURE_SSL_REDIRECT=1
# GATEWAY_NETWORK=rodem-mes_mesnet
